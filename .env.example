# CrimeNet Local Environment Configuration Template
# Copy this file to .env and adjust values for your local environment

# --- Database & Storage Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crimenet
DB_USERNAME=root
DB_PASSWORD=admin

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=crimenet123

# --- CrimeNet Service URLs & Ports ---
VISUALIZER_HOST=127.0.0.1
VISUALIZER_PORT=8050
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8000

# --- API Security & CORS ---
CRIMENET_API_KEY=replace_with_a_long_random_api_key
CRIMENET_OFFICER_BADGES=INSP-4409
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8050,http://127.0.0.1:8050
CRIMENET_CORS=http://localhost:8050,http://127.0.0.1:8050,http://localhost:8000,http://127.0.0.1:8000

# --- LLM Providers ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROK_API_BASE=https://api.x.ai/v1
GROK_API_KEY=
GROK_MODEL=grok-2-latest

GROQ_API_KEY=
OPENAI_API_KEY=
